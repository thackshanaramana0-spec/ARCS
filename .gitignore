# Third-party PgRC2 (GPL-3), cloned for benchmarking only — never vendored
# into this repo. Reproduce with:
#   git clone https://github.com/kowallus/PgRC.git method_c
#   cd method_c && mkdir build && cd build && cmake .. && make PgRC
method_c/

# Reimpl pipeline stream dumps (regenerable: DUMP_LIT=1 DUMP_PERM=1 ./best ...)
mem_*.bin
literal.txt
literal.2bit
perm.u32
pg_full.txt

# Reimpl stream dumps written to the CWD of whichever dir the encoder runs in.
# The rule above was `mem_*.bin`, which does not match `mm_*.bin` -- one letter
# apart -- so 18 MB of regenerable dumps sat unignored at the repo root.
mm_*.bin
orig2uid.bin
pos_abs.bin
pos_strand.bin
read_lengths.bin
n_indices.bin
n_reads.txt
n_pos.bin
n_cnt.bin

# Compiled reimpl encoders (regenerate: benchmark/reimpl/build106.sh)
benchmark/reimpl/best*
